        {"src": "litellm/litellm_plus_router.py", "dst": "utilities/litellm_plus_router.py"}
    ],
    "custom_domain": "https://kindness.social",
    "cron_yaml": true,
    "cloud_run_services": [
        {
            "name": "kindness-worker",
            "source": ".",
            "dockerfile": "worker/Dockerfile",
            "memory": "512Mi",
            "timeout": "900",
            "exclude_dirs": ["static", "templates", "docs", "tests", "prompts"]
        }
    ]
}
